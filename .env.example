# Onboarding Buddy configuration. Copy to ~/.config/onboarding-buddy/env on the GB10 (chmod 600).
# Never commit real values. Defaults run fully mocked.

OB_DB_PATH=data/onboarding.db
OB_STATUS_HOST=127.0.0.1
OB_STATUS_PORT=4600
OB_AGENT_NAME=Fleetwing Onboarding Agent   # name the agent uses for itself
OB_AGENT_SIGNATURE=false                   # true adds a "runs on NemoClaw/GB10" footer to chat replies
OB_MANAGER_SLACK_IDS=U_MGR_DANA            # comma-separated Slack member IDs allowed to approve
OB_NEW_HIRE_CHANNEL=#new-couriers          # live: the channel ID (C...)
# Live mode only emails or invites these addresses (comma-separated). Empty = nobody.
OB_LIVE_RECIPIENT_ALLOWLIST=

# Readiness checks before a Slack invite
OB_READY_REQUIRE_INTAKE=true
OB_READY_REQUIRE_PLAN_SENT=false   # the Slack questionnaire now runs before the plan

# Model: mock | nemoclaw | openai-compatible. Inference must stay on the GB10.
OB_LLM_MODE=mock
OB_NEMOCLAW_SANDBOX=gb10-agent             # nemoclaw mode: one OpenClaw runtime, a session per case
OB_LLM_BASE_URL=                           # openai-compatible mode, e.g. http://127.0.0.1:8001/v1 (Nemotron Nano)
OB_LLM_MODEL=                              # e.g. nemotron3-nano-4b-fp8
OB_LLM_API_KEY=
OB_LLM_DISABLE_THINKING=true
OB_LLM_TIMEOUT_MS=180000

# Email: mock | agentmail
OB_EMAIL_MODE=mock
OB_EMAIL_FROM=onboarding@fleetwing.example
OB_EMAIL_POLL_MS=15000
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Slack: mock | socket
OB_SLACK_MODE=mock
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Workspace invitations: mock | manual | slack-admin-api
OB_INVITE_MODE=mock
SLACK_ADMIN_USER_TOKEN=
SLACK_TEAM_ID=
